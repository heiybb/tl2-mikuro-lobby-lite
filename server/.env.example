# TL2 Mikuro Lobby Lite configuration. Copy to .env and edit.
# Precedence: command-line flags > environment variables > this file > built-in defaults.

# ---- listening ----
LOBBY_HOST=0.0.0.0
LOBBY_PORT=4549

# Address the players' games are told to send relay UDP to.
#   a fixed public IPv4, e.g. 203.0.113.10   (recommended)
#   public  = look it up at every start via api.ipify.org / icanhazip.com
#             (the only outbound request this server can make)
#   auto    = this machine's interface address (LAN / testing only)
RELAY_IP=auto
RELAY_PORT=4549

# Pair port pool: one UDP port per connected pair of players. TL2 is a full mesh,
# so an N-player game uses N*(N-1)/2 ports (4 players = 6, 6 players = 15).
# Open the whole UDP range in your firewall / cloud security group.
# 0 = single-port mode (only one joiner per game; not recommended).
RELAY_PORT_RANGE=4550-4999

# ---- access ----
# Optional shared password for classic logins (1.25.x clients): players type any
# name plus this password in the game's login box. Empty = anyone can log in.
# Use a long random string; see README "Security notes" for its limits.
LOBBY_PASSWORD=

# 1.26.x (TapTap login) clients cannot send a password. 1 = let them in anyway,
# 0 = refuse them (only meaningful together with LOBBY_PASSWORD).
ALLOW_TAPTAP=1

# ---- logging (stdout only, nothing is written to disk) ----
# 0 = mask the last two octets of player IPs in logs (default), 1 = log full IPs.
LOG_IPS=0
# 1 = debug log with a hexdump of every frame
LOBBY_VERBOSE=0
