<Window x:Class="TL2LobbyLauncher.ServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20">
    <TextBlock x:Name="lblName" Style="{StaticResource Label}"/>
    <TextBox x:Name="txtName" Margin="0,0,0,12"/>
    <TextBlock x:Name="lblHost" Style="{StaticResource Label}"/>
    <TextBox x:Name="txtHost" Margin="0,0,0,12"/>
    <TextBlock x:Name="lblPort" Style="{StaticResource Label}"/>
    <TextBox x:Name="txtPort" Margin="0,0,0,12" Width="100" HorizontalAlignment="Left"/>
    <TextBlock x:Name="lblAuth" Style="{StaticResource Label}"/>
    <TextBox x:Name="txtAuth"/>
    <TextBlock x:Name="txtAuthHint" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"/>
    <TextBlock x:Name="txtError" Foreground="#E0765A" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="btnCancel" IsCancel="True"/>
      <Button x:Name="btnOk" IsDefault="True" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
