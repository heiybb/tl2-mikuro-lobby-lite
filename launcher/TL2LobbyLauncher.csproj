<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TL2LobbyLauncher</AssemblyName>
    <RootNamespace>TL2LobbyLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <Product>TL2 Lobby Launcher</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 heiybb</Copyright>
    <Description>Pick which online lobby server Torchlight II connects to, then launch the game.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish settings; the full command is in README.md. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="servers.example.json" CopyToOutputDirectory="Never" />
    <!-- Built from the player's own DATA.PAK by pakpatch/build.py; holds our edits only. -->
    <EmbeddedResource Include="assets/pakpatch.json" LogicalName="pakpatch.json" />
  </ItemGroup>

</Project>
